# Copy to .env and fill in whatever you have. Every key is OPTIONAL —
# a missing key makes that data block fall back to the synthetic provider,
# and the dashboard's "Data sources" tab shows you exactly what was simulated.
#
#   cp .env.example .env

# ---------------------------------------------------------------- market data
# Binance spot/futures market data needs no key (public endpoints).
BINANCE_BASE_URL=https://api.binance.com

# CoinGecko: free tier works keyless; a key switches to the Pro host.
# https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# OANDA v20 — forex prices AND retail positioning (the contrarian sentiment input).
# https://developer.oanda.com/
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice          # practice | live

# Alpha Vantage — free forex fallback and US Treasury yields (rate-limited).
# https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# ------------------------------------------------------------ macro / calendar
# FRED — policy rates, CPI, sovereign yields, M2, BIS REER. Free, and the
# single highest-value key in this file: it powers RIRD, the yield curve and PPP.
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# TradingEconomics — economic calendar for the event blocker.
# The literal value guest:guest works as a limited free sample.
# https://developer.tradingeconomics.com/
TRADINGECONOMICS_API_KEY=

# ------------------------------------------------------ on-chain and sentiment
# Glassnode — on-chain transfer volume for token velocity / NVT (paid).
GLASSNODE_API_KEY=

# NewsAPI.org — headlines for the sentiment filter.
NEWSAPI_KEY=

# LunarCrush — crypto social dominance.
LUNARCRUSH_API_KEY=

# ------------------------------------------------------------------ interfaces
# Telegram alerts. Create a bot with @BotFather, then get your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -------------------------------------------------------------------- storage
# Default is a local SQLite file — zero setup.
# For production, point at TimescaleDB and the hypertables are created for you:
#   DATABASE_URL=postgresql+psycopg2://mfie:password@localhost:5432/mfie
DATABASE_URL=

# -------------------------------------------------------------------- runtime
MFIE_OFFLINE=false                  # true = never hit the network, all data simulated
HTTP_TIMEOUT=15
CACHE_TTL_SECONDS=300
LOG_LEVEL=INFO
